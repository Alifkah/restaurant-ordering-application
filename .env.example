# ========================================================
# Restaurant Ordering Application - Environment Variables
# ========================================================

# 1. Database (PostgreSQL / Neon Serverless)
# Example: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-quiet-glade-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth.js / Auth.js (v5)
AUTH_SECRET="super-secret-random-key-change-in-production-min-32-chars-length"
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"

# 3. Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_51placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_51placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# 4. Cloudinary Media Storage (Menu Images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# 5. App General Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
